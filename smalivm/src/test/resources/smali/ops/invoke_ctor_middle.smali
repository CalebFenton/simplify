.class public Linvoke_ctor_middle;
.super Ljava/lang/Object;

# The base constructor an outer constructor calls as super.<init>; its own base call is a synchronous Object.<init>.
.method public constructor <init>()V
    .locals 0
    invoke-direct {p0}, Ljava/lang/Object;-><init>()V
    return-void
.end method
